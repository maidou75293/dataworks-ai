# deploy.sh 宿主锚点/节点地址本地配置模板（REQ-OSS-PUBSCRUB-1：仓内零内网 IP 与个人盘符）。
#
# 用法：cp env.local.sh.example env.local.sh（env.local.sh 已 gitignore），按自己环境改值。
# 环境变量优先级更高：DW_OPS / DW_KEY / DW_REMOTE / DW_IMAGES / DW_NODES / DW_REGISTRY /
# DW_CRANE / DW_NODE。
DW_OPS=ubuntu@10.0.0.14                  # 控制机（Ansible 执行机）user@host
DW_KEY="$PWD/keys/id_ed25519"            # 私钥路径，默认 keys/ 随 deploy 目录整体拷走
DW_REMOTE=dataworks/deploy               # 控制机上的同步目标目录（相对 ~）
DW_IMAGES="$PWD/images"                  # 离线镜像目录
DW_NODES="10.0.0.11 10.0.0.12 10.0.0.13" # k3s 三节点 IP，空格分隔
DW_REGISTRY=10.0.0.11:30500              # 私有仓库地址（首节点 NodePort 30500）
DW_NODE=10.0.0.11                        # 首节点 IP（status/verify/agent-service 用）
DW_CRANE=crane                           # crane 可执行文件（PATH 里有 crane 可不管本行）
