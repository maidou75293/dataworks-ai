# 前端镜像：node 构建 SPA → nginx 托管并反代 /api 到 backend
# build 上下文 = web/（compose 里 context: ../../web），nginx.conf 走 additional_context "ops"
FROM docker.io/library/node:20-alpine AS build
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

FROM docker.io/library/nginx:1.27-alpine
COPY --from=build /src/dist /usr/share/nginx/html
COPY --from=ops nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
