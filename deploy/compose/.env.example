# compose 演示栈口令模板（REQ-OSS-QUICKSTART-1）
#
# 用法：cp .env.example .env 后自填；或直接 bash up.sh 自动生成随机口令。
# 不建 .env 也能 `docker compose up -d`——那会用 docker-compose.yml 里的 demo-* 兜底口令，
# 仅供本机看界面，切勿对外暴露。真实口令一律只监听本机端口，.env 已被 gitignore。

DB_NAME=dataworks_dev
DB_USER=dataworks
POSTGRES_PASSWORD=
DORIS_PASSWORD=
# 对象存储为 SeaweedFS S3（MinIO 公有镜像/二进制已停发，见 README）；凭据固定本机 demo，
# 与 ./s3/s3.json 保持一致，一般不需要动
S3_ACCESS_KEY=demoaccesskey
S3_SECRET_KEY=demosecretkey123
KEYCLOAK_ADMIN_USER=demoadmin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_MCP_CLIENT_SECRET=
# 32 字节 base64（AES-256-GCM 落盘加密主密钥；缺失后端拒启）
PLATFORM_SECRET_KEY=
PLATFORM_INTERNAL_TOKEN=
MCP_TOKEN=
# 一次性 admin 登录口令（up.sh 结尾打印一次）
PLATFORM_ADMIN_PASSWORD=
