{
  "name": "catalog.list_tables",
  "version": "1.0",
  "description": "列出指定 catalog.schema 下的表/文件集；只读。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "catalog": {
        "type": "string"
      },
      "schema": {
        "type": "string"
      }
    },
    "required": [
      "catalog",
      "schema"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "catalog": {
        "type": "string"
      },
      "schema": {
        "type": "string"
      },
      "tables": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "semantics": {
    "preconditions": [],
    "sideEffects": "none",
    "idempotent": true,
    "permissions": [
      "catalog.read"
    ],
    "requiresApproval": false,
    "errorCodes": [
      "CATALOG_UNAVAILABLE",
      "CATALOG_OBJECT_NOT_FOUND"
    ]
  },
  "examples": [
    {
      "input": {
        "catalog": "doris_dev",
        "schema": "kb_dev"
      },
      "output": {
        "catalog": "doris_dev",
        "schema": "kb_dev",
        "tables": [
          "kb_chunk"
        ]
      }
    }
  ]
}
