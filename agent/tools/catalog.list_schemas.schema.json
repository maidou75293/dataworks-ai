{
  "name": "catalog.list_schemas",
  "version": "1.0",
  "description": "列出指定 catalog 下的 schema（库）；只读。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "catalog": {
        "type": "string"
      }
    },
    "required": [
      "catalog"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "catalog": {
        "type": "string"
      },
      "schemas": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "semantics": {
    "preconditions": [],
    "sideEffects": "none",
    "idempotent": true,
    "permissions": [
      "catalog.read"
    ],
    "requiresApproval": false,
    "errorCodes": [
      "CATALOG_UNAVAILABLE",
      "CATALOG_OBJECT_NOT_FOUND"
    ]
  },
  "examples": [
    {
      "input": {
        "catalog": "doris_dev"
      },
      "output": {
        "catalog": "doris_dev",
        "schemas": [
          "kb_dev",
          "mysql"
        ]
      }
    }
  ]
}
