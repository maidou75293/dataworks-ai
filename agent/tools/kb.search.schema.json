{
  "name": "kb.search",
  "version": "1.0",
  "description": "语义检索知识库，返回 Top-K 片段与引用；只读，自动注入 ACL 过滤。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string"
      },
      "kb_id": {
        "type": "integer"
      },
      "top_k": {
        "type": "integer",
        "default": 5,
        "minimum": 1,
        "maximum": 50
      },
      "acl_tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "is_query": {
        "type": "boolean",
        "default": true
      }
    },
    "required": [
      "query"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "results": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "chunk_id": {
              "type": "integer"
            },
            "doc_id": {
              "type": "integer"
            },
            "title": {
              "type": "string"
            },
            "content": {
              "type": "string"
            },
            "score": {
              "type": "number"
            }
          }
        }
      }
    }
  },
  "semantics": {
    "preconditions": [
      "kb.exists",
      "user.authorized"
    ],
    "sideEffects": "none",
    "idempotent": true,
    "permissions": [
      "kb.read"
    ],
    "requiresApproval": false,
    "errorCodes": [
      "KB_NOT_FOUND",
      "EMBEDDING_UNAVAILABLE",
      "DORIS_TIMEOUT"
    ]
  },
  "examples": [
    {
      "input": {
        "query": "报销标准是多少？",
        "kb_id": 1,
        "top_k": 5,
        "acl_tags": [
          "finance"
        ]
      },
      "output": {
        "results": [
          {
            "chunk_id": 42,
            "doc_id": 1001,
            "title": "报销制度",
            "content": "...",
            "score": 0.91
          }
        ]
      }
    }
  ]
}