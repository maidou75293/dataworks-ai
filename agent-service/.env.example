# agent-service 环境变量样例（BUG-AGENT-KEY-FIX-1，2026-11-04）
# 真源=集群 Secret platform-keys（键 AGENT_MODEL_API_KEY），取值：
#   bash scripts/ops/secret.sh get platform-keys AGENT_MODEL_API_KEY --show
# 部署侧（deploy.sh agent-service / site.yml 的 60-agent-service.yml）在 .env 缺行或为空时
# 从 Secret 收敛补齐；**已有非空值一律不覆盖**（运维手填优先）。
# 模型三行也可在「系统配置 → 对话智能体」区块里改（REQ-AGENT-CFGPANEL-1）：
# 页面上的改动经 POST /api/config 写回本文件并立即生效（免重启），密钥只显示
# 「已配置 + 尾 4 位指纹」，永不回显明文。
AGENT_MODEL_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
AGENT_MODEL_NAME=qwen3.8-flash
AGENT_MODEL_API_KEY=
BACKEND_URL=http://127.0.0.1:30090
PLATFORM_INTERNAL_TOKEN=
AGENT_SERVICE_TOKEN=
